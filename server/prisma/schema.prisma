
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  logoUrl      String?
  isActive     Boolean       @default(true)
  users        User[]
  projects     Project[]
  tasks        Task[]
  notifications Notification[]
  inviteTokens InviteToken[]
  subscription Subscription?
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model User {
  id             String          @id @default(uuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  email          String
  passwordHash   String
  role           Role            @default(MEMBER)
  isActive       Boolean         @default(true)
  emailVerifiedAt DateTime?
  failedLoginCount Int           @default(0)
  lockedUntil    DateTime?
  refreshTokens  RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  notificationPreference   NotificationPreference?
  projectMembers ProjectMember[]
  createdTasks   Task[]          @relation("TaskCreator")
  assignedTasks  TaskAssignee[]
  comments       Comment[]
  notifications  Notification[]
  sentInvites    InviteToken[]   @relation("SentInvites")
  taskActivities TaskActivity[]
  uploadedAttachments Attachment[] @relation("UploadedAttachments")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model InviteToken {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        Role     @default(MEMBER)
  invitedById String
  invitedBy   User     @relation("SentInvites", fields: [invitedById], references: [id])
  token       String   @unique
  isAccepted  Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([email])
}

model Project {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Keep in sync with DEFAULT_PROJECT_COLOR in @taskflow/shared.
  color       String?         @default("#6366f1")
  status      ProjectStatus   @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  isDeleted   Boolean         @default(false)
  members     ProjectMember[]
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, isDeleted])
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Task {
  id           String         @id @default(uuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  createdById  String
  createdBy    User           @relation("TaskCreator", fields: [createdById], references: [id])
  parentTaskId String?
  parentTask   Task?          @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     Task[]         @relation("SubTasks")
  title        String
  description  String?
  status       TaskStatus     @default(TODO)
  priority     Priority       @default(MEDIUM)
  dueDate      DateTime?
  // Set once a DUE_SOON reminder has been sent so the job doesn't re-notify.
  dueReminderSentAt DateTime?
  order        Int            @default(0)
  isDeleted    Boolean        @default(false)
  assignees    TaskAssignee[]
  comments     Comment[]
  activities   TaskActivity[]
  attachments  Attachment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([projectId, tenantId, status])
  @@index([projectId, order])
  @@index([tenantId, isDeleted])
  @@index([createdById])
}

model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  parentId  String?
  content   String
  isEdited  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, isDeleted])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  type      NotificationType
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskAssigned   Boolean  @default(true)
  taskDue        Boolean  @default(true)
  commentMention Boolean  @default(true)
  memberJoined   Boolean  @default(true)
  projectUpdate  Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model Subscription {
  id          String             @id @default(uuid())
  tenantId    String             @unique
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan   @default(FREE)
  status      SubscriptionStatus @default(ACTIVE)
  seats       Int                @default(3)
  // Provider integration (e.g. Stripe). Null while on the built-in stub provider.
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  invoices    Invoice[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Invoice {
  id             String        @id @default(uuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  number         String        @unique
  // Amount in the smallest currency unit (cents).
  amountCents    Int
  currency       String        @default("usd")
  status         InvoiceStatus @default(PAID)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime      @default(now())

  @@index([subscriptionId, createdAt])
}

// Immutable log of task changes (status/assignee/priority/etc.) — powers the
// "who changed what, when" activity feed on a task.
model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

// File attached to a task. Bytes live in object storage (S3/local); this row is
// the metadata + storage key.
model Attachment {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenantId     String
  uploadedById String
  uploadedBy   User     @relation("UploadedAttachments", fields: [uploadedById], references: [id])
  filename     String
  contentType  String
  sizeBytes    Int
  storageKey   String
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([tenantId])
}

// Append-only audit trail of security-relevant events (role changes, plan
// changes, deactivations, deletions) for compliance and incident response.
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ── ENUMS ──
enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum ProjectRole {
  MANAGER
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  DUE_SOON
  MENTIONED
  MEMBER_JOINED
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  PAID
  OPEN
  VOID
}
