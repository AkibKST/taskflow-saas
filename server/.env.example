# ─── Core ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Primary connection (pooled, via PgBouncer / Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname?pgbouncer=true

# Direct connection for migrations
DIRECT_URL=postgresql://user:password@host:5432/dbname

# ─── Auth / JWT ─────────────────────────────────────────────────────────
JWT_SECRET=your-access-token-secret-here
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# ─── Infrastructure (optional) ──────────────────────────────────────────
# Set when running behind a proxy/load balancer. `true`, `false`, or a hop
# count (e.g. 1). Defaults to 1 in production so the rate limiter keys on the
# real client IP rather than the proxy's.
# TRUST_PROXY=1

# Enables the Socket.IO Redis adapter, cross-instance presence, a shared
# rate-limit store, and distributed job locks. Leave unset for single-instance.
# REDIS_URL=redis://localhost:6379

# Max accepted JSON body size (default 256kb).
# JSON_BODY_LIMIT=256kb

# ─── Email provider (optional in dev; REQUIRED in production) ────────────
# Preferred: Resend (https://resend.com) — just an API key, no SDK needed.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Alternative: any SMTP server (used only if RESEND_API_KEY is unset).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=xxxxxxxx
# SMTP_SECURE=false
# From address on all transactional mail.
EMAIL_FROM=TaskFlow <no-reply@taskflow.local>

# ─── Billing / Stripe (optional; falls back to the built-in stub) ───────
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Stripe Price IDs for each paid plan.
# STRIPE_PRICE_PRO=price_xxxxxxxx
# STRIPE_PRICE_ENTERPRISE=price_xxxxxxxx

# ─── Attachment storage (optional; defaults to local disk) ──────────────
# STORAGE_DRIVER=local            # local | s3
# STORAGE_LOCAL_DIR=uploads
# S3_BUCKET=taskflow-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=xxxx
# S3_SECRET_ACCESS_KEY=xxxx
# S3_ENDPOINT=https://s3.amazonaws.com   # or an S3-compatible endpoint
# S3_PUBLIC_URL=https://cdn.example.com  # optional public base URL

# ─── Observability (optional) ───────────────────────────────────────────
# SENTRY_DSN=https://xxxx@sentry.io/xxxx

# ─── Policy ─────────────────────────────────────────────────────────────
# Require a verified email before inviting teammates / changing billing.
REQUIRE_EMAIL_VERIFICATION=false
